# Copy this file to .env and fill it in. .env is gitignored; this example is not,
# so never put real values in this file.
#
# Neon connection string for the DEV branch
# (Neon dashboard > Connect > pick the dev branch > direct connection, not pooled).
# Leave it empty to use the local SQLite file (players.db) instead.
# Production uses the main-branch string, set in Render > Environment, not here.
DATABASE_URL=
# looks like: postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require
